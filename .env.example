# ==========================================
# TechNeekX Community Reporting & Task Management System
# Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==========================================

# ------------------------------------------
# Django Backend Settings
# ------------------------------------------
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------
# Privileged Self-Registration Keys
# Leave empty to disable Founder self-registration and keep Director sign-ups Pending
# until an administrator approves them. Use long random values when set.
# ------------------------------------------
FOUNDER_SETUP_KEY=
DIRECTOR_SETUP_KEY=

# ------------------------------------------
# PostgreSQL Database Settings (set USE_SQLITE=False to use PostgreSQL)
# ------------------------------------------
USE_SQLITE=True
DB_NAME=techneekx_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------
# CORS & Security Settings
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------
# Frontend Environment Settings
# (For use with Vite / React: prefix with VITE_)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE="TechNeekX Reporting System"
# External website links shown in the sidebar (hidden when empty).
# FS = the parent organization's main website.
VITE_TECHNEEKX_SITE_URL=
VITE_FS_SITE_URL=
